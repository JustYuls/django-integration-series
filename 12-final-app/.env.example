# Copy this file to .env and fill in real values. Never commit the real .env file.
# These are read as ENVIRONMENT VARIABLES: load them with your shell, your host, or a tool of your choice.

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=generate-a-long-random-value-here
DJANGO_ALLOWED_HOSTS=campus.example.com,www.campus.example.com

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=bookings@campus.example
EMAIL_HOST_PASSWORD=put-the-real-password-in-the-real-.env-only
DEFAULT_FROM_EMAIL=bookings@campus.example

# Optional
HOLIDAYS_ENABLED=1
